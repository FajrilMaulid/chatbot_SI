        print(f"Server berjalan di: http://localhost:{port}")
        print("Tekan Ctrl+C untuk menghentikan server")
    print("="*50 + "\n")
    
    app.run(
        debug=not is_production,  # Disable debug in production
        host='0.0.0.0', 
        port=port
    )

