@app.route('/api/admin/chat-logs', methods=['GET'])
@require_admin
def get_chat_logs():
    """Get chat logs with pagination"""
    try:
        limit = int(request.args.get('limit', 50))
        offset = int(request.args.get('offset', 0))
        search = request.args.get('search', None)
        
        result = admin_api.get_all_chat_logs(cursor, limit, offset, search)
        return jsonify({'status': 'success', 'data': result})
    except Exception as e:
        print(f"Error getting chat logs: {e}")
        return jsonify({'error': 'Failed to get chat logs'}), 500

